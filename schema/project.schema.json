{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzczepanGrela/grela-dev-roadmap/schema/project.schema.json",
  "title": "grela.dev roadmap project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slug", "order", "name", "summary", "repository", "classification", "hosting", "status", "progress", "complexity", "forecast", "estimation", "focus", "tasks", "compliance", "verification", "media", "decisions", "audit"],
  "properties": {
    "schemaVersion": {"const": 2},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "order": {"type": "integer", "minimum": 1, "maximum": 14},
    "name": {"$ref": "#/$defs/localized"},
    "summary": {"$ref": "#/$defs/localized"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "currentName", "targetName", "url", "ownerId", "repositoryId", "defaultBranch", "visibility"],
      "properties": {
        "owner": {"const": "SzczepanGrela"},
        "currentName": {"type": "string", "minLength": 1},
        "targetName": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/SzczepanGrela/"},
        "ownerId": {"const": 115424220},
        "repositoryId": {"type": "integer", "minimum": 1},
        "defaultBranch": {"enum": ["main", "master"]},
        "visibility": {"const": "public"}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "technologies", "hosted"],
      "properties": {
        "kind": {"enum": ["web", "desktop", "repository", "developer-tool"]},
        "technologies": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "hosted": {"type": "boolean"}
      }
    },
    "hosting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "url", "deploymentState"],
      "properties": {
        "target": {"enum": ["none", "vps", "static-pages"]},
        "url": {"type": ["string", "null"], "format": "uri"},
        "deploymentState": {"enum": ["not-applicable", "not-started", "configured", "deployed", "degraded"]}
      }
    },
    "status": {"enum": ["planned", "active", "paused", "blocked", "complete", "maintenance"]},
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "implementation", "quality", "documentation", "delivery"],
      "properties": {
        "overall": {"$ref": "#/$defs/percentage"},
        "implementation": {"$ref": "#/$defs/percentage"},
        "quality": {"$ref": "#/$defs/percentage"},
        "documentation": {"$ref": "#/$defs/percentage"},
        "delivery": {"$ref": "#/$defs/percentage"}
      }
    },
    "complexity": {"type": "integer", "minimum": 1, "maximum": 5},
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remainingHoursMin", "remainingHoursMax", "remainingDaysMin", "remainingDaysMax", "hoursPerDay", "hoursPerWeek", "earliest", "latest", "confidence"],
      "properties": {
        "remainingHoursMin": {"type": "integer", "minimum": 0},
        "remainingHoursMax": {"type": "integer", "minimum": 0},
        "remainingDaysMin": {"$ref": "#/$defs/workDays"},
        "remainingDaysMax": {"$ref": "#/$defs/workDays"},
        "hoursPerDay": {"const": 8},
        "hoursPerWeek": {"const": 30},
        "earliest": {"type": "string", "format": "date"},
        "latest": {"type": "string", "format": "date"},
        "confidence": {"enum": ["low", "medium", "high"]}
      }
    },
    "estimation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "mode", "sourceRevision", "sourceState"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "mode": {"const": "codex-assisted-source-audited"},
        "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sourceState": {"type": "string", "minLength": 1}
      }
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "next"],
      "properties": {
        "current": {"$ref": "#/$defs/localized"},
        "next": {"$ref": "#/$defs/localized"}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/task"}
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standardVersion", "profile", "assessmentDate", "controls"],
      "properties": {
        "standardVersion": {"const": 2},
        "profile": {"enum": ["vps-web", "static-web", "desktop", "repository", "developer-tool"]},
        "assessmentDate": {"type": "string", "format": "date"},
        "controls": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/complianceControl"}
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktree", "tests", "ci", "production"],
      "properties": {
        "worktree": {"type": "string"},
        "tests": {"type": "string"},
        "ci": {"type": "string"},
        "production": {"type": "string"}
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenshot", "fallback", "captureEnabled", "attribution"],
      "properties": {
        "screenshot": {"type": "string", "pattern": "^assets/screenshots/"},
        "fallback": {"type": "string", "pattern": "^assets/placeholders/"},
        "captureEnabled": {"type": "boolean"},
        "attribution": {"type": "string"}
      }
    },
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/localized"}},
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "sources", "notes"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "notes": {"$ref": "#/$defs/localized"}
      }
    }
  },
  "$defs": {
    "percentage": {"type": "integer", "minimum": 0, "maximum": 100},
    "workDays": {"type": "number", "minimum": 0, "multipleOf": 0.25},
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "pl"],
      "properties": {"en": {"type": "string", "minLength": 1}, "pl": {"type": "string", "minLength": 1}}
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "dimension", "status", "completion", "weight", "difficulty", "hoursMin", "hoursMax", "daysMin", "daysMax", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"$ref": "#/$defs/localized"},
        "dimension": {"enum": ["implementation", "quality", "documentation", "delivery"]},
        "status": {"enum": ["planned", "in-progress", "blocked", "done"]},
        "completion": {"$ref": "#/$defs/percentage"},
        "weight": {"type": "integer", "minimum": 1, "maximum": 5},
        "difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
        "hoursMin": {"type": "integer", "minimum": 0},
        "hoursMax": {"type": "integer", "minimum": 0},
        "daysMin": {"$ref": "#/$defs/workDays"},
        "daysMax": {"$ref": "#/$defs/workDays"},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "complianceControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence", "taskIds"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "status": {"enum": ["complete", "partial", "missing", "unverified", "blocked", "not-applicable"]},
        "evidence": {"$ref": "#/$defs/localized"},
        "taskIds": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "uniqueItems": true
        }
      }
    }
  }
}
